# Copy to .env and replace every value with a random 32-byte hex string.
CERBERUS_BACKEND_URL=http://127.0.0.1:3000
CERBERUS_MCP_TOKEN=replace-with-random-hex
CERBERUS_COOKIE_SECRET=replace-with-random-hex
CERBERUS_JOB_TOKEN=replace-with-random-hex
CERBERUS_INGEST_SECRET=replace-with-random-hex
CERBERUS_WS_ROOT=./.cerberus-ws
CERBERUS_MAX_WORKERS=2
CERBERUS_ALLOW_MUTATION=true

# Atlassian / Bitbucket — fill when Forge integration starts
ATLASSIAN_SITE_URL=
ATLASSIAN_EMAIL=
BITBUCKET_WORKSPACE=
# Product source repository
BITBUCKET_REPO_SLUG=
BITBUCKET_USERNAME=
# Integration fixture repository verified by Cerberus
BITBUCKET_TRAPDOOR_REPO_SLUG=
BITBUCKET_TRAPDOOR_CLONE_URL=
# Bitbucket API token (app passwords were removed in 2026).
# API auth uses ATLASSIAN_EMAIL + this token, not BITBUCKET_USERNAME.
BITBUCKET_API_TOKEN=
# Jira — key of the project Cerberus manages (CERB)
JIRA_PROJECT_KEY=CERB
# Working Jira credential. Used as Basic auth against https://<site>.atlassian.net
JIRA_API_TOKEN=
# Scope-limited token. Only usable through https://api.atlassian.com/ex/jira/{cloudId}
JIRA_SCOPED_TOKEN=
# Site UUID for the gateway form. Leave empty to use JIRA_API_TOKEN on the site URL.
JIRA_CLOUD_ID=

# Cloud — leave empty to use a tunnel
GCP_PROJECT_ID=
GCP_REGION=us-central1
